---
import Base from "@/layouts/Base.astro";
import * as c from "@/content/industries/ecommerce-retail";
import { brand } from "@/lib/content";
import { EcommerceRetailPage } from "@/page-bodies/industries-ecommerce-retail";

/* Head tags are handed to the layout as props; the structured data is emitted
   below as static HTML rather than through the island.

   THE SCHEMA IS BUILT FROM THE DOCUMENT, NOT WRITTEN. `serviceType` joins the
   six service headings the client's own document lists, and `audience` is the
   eight kinds of business its "Who Do We Work With" section names, so no
   wording here is ours. This is an industry page rather than a service page,
   so the Service is not `isPartOf` a pillar: the document sells a combined
   programme -- "ENH Marketing brings SEO, PPC, social media, content, website
   support and reporting into one ecommerce strategy" -- and claiming it sits
   under one of those pillars would contradict that sentence. */

const HREF = "/e-commerce-marketing-agency";

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Ecommerce Growth Marketing",
  serviceType: c.services.items.map((s) => s.title).join(", "),
  areaServed: { "@type": "Country", name: "United Arab Emirates" },
  audience: c.audience.items.map((a) => ({ "@type": "Audience", audienceType: a.label })),
  provider: {
    "@type": "Organization",
    name: brand.legal,
    url: "https://enhmedia.com",
    telephone: brand.phone,
    address: { "@type": "PostalAddress", streetAddress: brand.address, addressCountry: "AE" },
  },
};
---

<Base title={c.meta.title} description={c.meta.description} canonical={HREF}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(serviceSchema)} />

  <EcommerceRetailPage client:load />
</Base>
