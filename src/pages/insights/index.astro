---
import Base from "@/layouts/Base.astro";
import * as c from "@/content/insights";
import { brand } from "@/lib/content";
import { InsightsPage } from "@/page-bodies/insights";

/* Insights — the archive index.
 *
 * Same shape as every other page: head tags handed to the layout as props, the
 * React body mounted as one island, structured data emitted here as static
 * HTML so a crawler reads it without running any JavaScript.
 *
 * THE Blog SCHEMA LISTS ONLY THE NOTES THAT ANSWER A URL. `published()` is
 * empty until the articles are migrated, so today this emits a Blog with no
 * blogPost array — which describes the page truthfully — rather than three
 * BlogPosting entries pointing at /insights/<slug> addresses that 404. A
 * schema that names URLs a crawler cannot fetch is worse for the site than no
 * schema at all, and it is the same rule Breadcrumbs already applies when it
 * omits `item` for an unbuilt level.
 *
 * The route lives at insights/index.astro rather than insights.astro so the
 * article route can sit beside it as insights/[slug].astro.
 */

const HREF = "/insights";
const SITE = "https://enhmedia.com";

const posts = c.published();

const blogSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "@id": `${SITE}${HREF}#blog`,
  name: "ENH Insights",
  description: c.meta.description,
  url: `${SITE}${HREF}`,
  inLanguage: "en-AE",
  publisher: {
    "@type": "Organization",
    name: brand.legal,
    url: SITE,
    telephone: brand.phone,
    address: {
      "@type": "PostalAddress",
      streetAddress: brand.address,
      addressCountry: "AE",
    },
  },
  ...(posts.length
    ? {
        blogPost: posts.map((note) => ({
          "@type": "BlogPosting",
          "@id": `${SITE}${HREF}/${note.slug}#article`,
          headline: note.title,
          url: `${SITE}${HREF}/${note.slug}`,
          datePublished: note.date,
          ...(note.updated ? { dateModified: note.updated } : {}),
          ...(note.excerpt ? { description: note.excerpt } : {}),
          articleSection: note.category,
          ...(note.author ? { author: { "@type": "Person", name: note.author.name } } : {}),
        })),
      }
    : {}),
};
---

<Base
  title={c.meta.title}
  description={c.meta.description}
  canonical={HREF}
  ogTitle={c.meta.ogTitle}
  ogDescription={c.meta.ogDescription}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(blogSchema)} />

  <InsightsPage client:load />
</Base>
