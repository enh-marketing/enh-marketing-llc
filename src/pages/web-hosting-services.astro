---
import Base from "@/layouts/Base.astro";
import * as c from "@/content/services/web-hosting";
import { brand } from "@/lib/content";
import { WebHostingPage } from "@/page-bodies/services-web-design-development-web-hosting";

/* Same shape as the two sibling pages under this pillar: head tags handed to
   the layout as props, structured data emitted here as static HTML rather than
   through the island.

   THE SLUG. src/lib/sitemap.ts has named this page
   /services/web-design-development/web-hosting since the IA was resolved, and
   both the pillar page and the ecommerce page already link to that address, so
   it is the canonical one. The "-services" variant matches the document's own
   H1 and gets typed by hand, so it is carried as a redirect in
   astro.config.mjs rather than served as a second URL: exactly the arrangement
   the maintenance page's "and" variant already has. */

const HREF = "/web-hosting-services";

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Web Hosting Services",
  serviceType:
    "Managed website hosting: hosting environment and setup, website migration, SSL certificate management, daily backups, uptime and technical monitoring, performance and resource management, technical hosting support",
  areaServed: { "@type": "Country", name: "United Arab Emirates" },
  provider: {
    "@type": "Organization",
    name: brand.legal,
    url: "https://enhmedia.com",
    telephone: brand.phone,
    address: { "@type": "PostalAddress", streetAddress: brand.address, addressCountry: "AE" },
  },
  isPartOf: {
    "@type": "Service",
    name: "Web Design & Development",
    url: "https://enhmedia.com/services/web-design-development",
  },
};
---

<Base title={c.meta.title} description={c.meta.description} canonical={HREF}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(serviceSchema)} />

  <WebHostingPage client:load />
</Base>
