---
import Base from "@/layouts/Base.astro";
import { Experience } from "@/components/Experience";
import { HomeSections } from "@/components/HomeSections";
import { availableBadges } from "@/lib/badges";

/* Resolved here rather than in the island for the same reason it was resolved
   in the server component before: availableBadges() reads the filesystem. In
   Astro this frontmatter runs at build time in Node, so the check still
   happens once, at build, and travels down as plain data. */
const badges = availableBadges();

/** The homepage was the ONE page on the site with no canonical. Fifty-seven
 *  `.astro` pages passed one and this did not, so the most-linked URL on the
 *  domain was the only one not naming itself — and it is the URL most likely
 *  to be reached by several spellings at once (with and without `www`, over
 *  http, with campaign parameters on the end from every ad the agency runs).
 *
 *  Written as the same `const HREF` every other page uses, and as a path
 *  rather than a URL: the layout resolves it against `site` in
 *  astro.config.mjs, so there is one place the domain is written down.
 *  "/" resolves to `https://enhmedia.com/`, which is character for character
 *  what src/pages/sitemap.xml.ts already lists for this route. */
const HREF = "/";
---

<Base
  title="Best Digital Marketing Agency in Dubai, UAE | ENH Marketing"
  description="ENH Marketing is a Google Partner digital marketing agency in Dubai, UAE. Expert SEO, PPC, social media and web services that drive leads and sales. Get a free audit."
  canonical={HREF}
  ogTitle="ENH — Explore New Heights"
  ogDescription="A Dubai-based digital growth studio crafting brands, campaigns and experiences that move markets."
>
  {/* TWO ISLANDS, NOT ONE, AND THE SPLIT IS BETWEEN THE HERO AND THE REST.
      This carried a note saying the page could not be split without inventing
      a shared store. That was true of the state it named -- `started`, handed
      from Preloader to Hero -- and that state stays inside <Experience>, on
      one side of the cut. Nothing below the hero reads it, and nothing below
      takes a React element as a prop either, which is the other thing
      MIGRATION.md warns island boundaries cannot carry.

      WHY IT HAD TO MOVE. The homepage pulls about a megabyte of uncompressed
      JavaScript, motion/react alone being 358KB, and every byte of it hydrated
      in one client:load block. On an iPhone that block runs 3-4 seconds, and
      it began the instant the preloader's opaque veil lifted -- so the page
      arrived and then sat there, unresponsive, exactly as reported.

      The hero stays client:load because it has to answer the preloader. The
      rest hydrates on idle: its markup is server-rendered either way, so
      nothing is missing or late, only its JavaScript waits for a free main
      thread. */}
  <main>
    <Experience client:load badges={badges} />
    <HomeSections client:idle />
  </main>
</Base>
