---
import Base from "@/layouts/Base.astro";
import * as c from "@/content/services/ecommerce";
import { brand } from "@/lib/content";
import { EcommercePage } from "@/page-bodies/services-web-design-development-ecommerce-website-development";

/* Was `export const metadata` plus a module-scope schema object in
   src/app/services/web-design-development/ecommerce-website-development/page.tsx. The head tags are handed to the layout as props;
   the structured data is emitted below, in the same place in the document it
   occupied before, and as static HTML rather than through the island. */

const HREF = "/services/web-design-development/ecommerce-website-development";

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Ecommerce Website Development",
  serviceType: "Ecommerce website design, development and integration",
  areaServed: { "@type": "Country", name: "United Arab Emirates" },
  provider: {
    "@type": "Organization",
    name: brand.legal,
    url: "https://enhmedia.com",
    telephone: brand.phone,
    address: { "@type": "PostalAddress", streetAddress: brand.address, addressCountry: "AE" },
  },
  isPartOf: {
    "@type": "Service",
    name: "Web Design & Development",
    url: "https://enhmedia.com/services/web-design-development",
  },
};
---

<Base
  title={c.meta.title}
  description={c.meta.description}
  canonical={HREF}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(serviceSchema)} />

  <EcommercePage client:load />
</Base>
