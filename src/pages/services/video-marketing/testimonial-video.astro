---
import Base from "@/layouts/Base.astro";
import * as c from "@/content/services/testimonial-video";
import { brand } from "@/lib/content";
import { TestimonialVideoPage } from "@/page-bodies/services-video-marketing-testimonial-video";

const HREF = "/services/video-marketing/testimonial-video";

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Testimonial Video Production",
  serviceType:
    "Testimonial video production: customer testimonials, client case study video, product testimonials, service experience video, project outcome video and short testimonial clips",
  areaServed: { "@type": "Country", name: "United Arab Emirates" },
  provider: {
    "@type": "Organization",
    name: brand.legal,
    url: "https://enhmedia.com",
    telephone: brand.phone,
    address: { "@type": "PostalAddress", streetAddress: brand.address, addressCountry: "AE" },
  },
  isPartOf: {
    "@type": "Service",
    name: "Video Marketing",
    url: "https://enhmedia.com/services/video-marketing",
  },
};
---

<Base title={c.meta.title} description={c.meta.description} canonical={HREF}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(serviceSchema)} />
  <TestimonialVideoPage client:load />
</Base>
