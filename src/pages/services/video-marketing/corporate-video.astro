---
import Base from "@/layouts/Base.astro";
import * as c from "@/content/services/corporate-video";
import { brand } from "@/lib/content";
import { CorporateVideoPage } from "@/page-bodies/services-video-marketing-corporate-video";

const HREF = "/services/video-marketing/corporate-video";

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Corporate Video Production",
  serviceType:
    "Corporate video production: company profile films, training video, internal communications, brand film, product explainers, testimonials, event and CSR video",
  areaServed: { "@type": "Country", name: "United Arab Emirates" },
  provider: {
    "@type": "Organization",
    name: brand.legal,
    url: "https://enhmedia.com",
    telephone: brand.phone,
    address: { "@type": "PostalAddress", streetAddress: brand.address, addressCountry: "AE" },
  },
  isPartOf: {
    "@type": "Service",
    name: "Video Marketing",
    url: "https://enhmedia.com/services/video-marketing",
  },
};
---

<Base title={c.meta.title} description={c.meta.description} canonical={HREF}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(serviceSchema)} />
  <CorporateVideoPage client:load />
</Base>
