---
import Base from "@/layouts/Base.astro";
import * as c from "@/content/services/explainer-video";
import { brand } from "@/lib/content";
import { ExplainerVideoPage } from "@/page-bodies/services-video-marketing-explainer-video";

const HREF = "/services/video-marketing/explainer-video";

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Explainer Video Production",
  serviceType:
    "Explainer video production: 2D animation, motion graphics, product explainers, software walkthroughs, service and process explainers, training and internal video",
  areaServed: { "@type": "Country", name: "United Arab Emirates" },
  provider: {
    "@type": "Organization",
    name: brand.legal,
    url: "https://enhmedia.com",
    telephone: brand.phone,
    address: { "@type": "PostalAddress", streetAddress: brand.address, addressCountry: "AE" },
  },
  isPartOf: {
    "@type": "Service",
    name: "Video Marketing",
    url: "https://enhmedia.com/services/video-marketing",
  },
};
---

<Base title={c.meta.title} description={c.meta.description} canonical={HREF}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(serviceSchema)} />
  <ExplainerVideoPage client:load />
</Base>
