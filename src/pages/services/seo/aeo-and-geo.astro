---
import Base from "@/layouts/Base.astro";
import * as c from "@/content/services/aeo-geo";
import { brand } from "@/lib/content";
import { AeoGeoPage } from "@/page-bodies/services-seo-aeo-and-geo";

/* Was `export const metadata` plus a module-scope schema object in
   src/app/services/seo/aeo-and-geo/page.tsx. The head tags are handed to the layout as props;
   the structured data is emitted below, in the same place in the document it
   occupied before, and as static HTML rather than through the island. */

const HREF = "/services/seo/aeo-and-geo";

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "AEO and GEO",
  serviceType: "AI search visibility across answer and generative engines",
  areaServed: { "@type": "Country", name: "United Arab Emirates" },
  provider: {
    "@type": "Organization",
    name: brand.legal,
    url: "https://enhmedia.com",
    telephone: brand.phone,
    address: { "@type": "PostalAddress", streetAddress: brand.address, addressCountry: "AE" },
  },
  isPartOf: {
    "@type": "Service",
    name: "Search Engine Optimisation",
    url: "https://enhmedia.com/services/seo",
  },
};
---

<Base
  title={c.meta.title}
  description={c.meta.description}
  canonical={HREF}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(serviceSchema)} />

  <AeoGeoPage client:load />
</Base>
