---
import Base from "@/layouts/Base.astro";
import * as c from "@/content/services/ecommerce-seo";
import { brand } from "@/lib/content";
import { EcommerceSeoPage } from "@/page-bodies/services-seo-ecommerce-seo";

const HREF = "/services/seo/ecommerce-seo";

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Ecommerce SEO",
  serviceType:
    "Ecommerce SEO: keyword research, store architecture, category and product page optimisation, technical SEO, product structured data, content and international targeting",
  areaServed: { "@type": "Country", name: "United Arab Emirates" },
  provider: {
    "@type": "Organization",
    name: brand.legal,
    url: "https://enhmedia.com",
    telephone: brand.phone,
    address: { "@type": "PostalAddress", streetAddress: brand.address, addressCountry: "AE" },
  },
  isPartOf: {
    "@type": "Service",
    name: "SEO",
    url: "https://enhmedia.com/services/seo",
  },
};
---

<Base title={c.meta.title} description={c.meta.description} canonical={HREF}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(serviceSchema)} />
  <EcommerceSeoPage client:load />
</Base>
