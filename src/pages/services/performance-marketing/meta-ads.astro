---
import Base from "@/layouts/Base.astro";
import * as c from "@/content/services/meta-ads";
import { brand } from "@/lib/content";
import { MetaAdsPage } from "@/page-bodies/services-performance-marketing-meta-ads";

/* Was `export const metadata` plus a module-scope schema object in
   src/app/services/performance-marketing/meta-ads/page.tsx. The head tags are handed to the layout as props;
   the structured data is emitted below, in the same place in the document it
   occupied before, and as static HTML rather than through the island. */

const HREF = "/services/performance-marketing/meta-ads";

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Meta Ads",
  serviceType: "Facebook and Instagram advertising management",
  areaServed: { "@type": "Country", name: "United Arab Emirates" },
  provider: {
    "@type": "Organization",
    name: brand.legal,
    url: "https://enhmedia.com",
    telephone: brand.phone,
    address: { "@type": "PostalAddress", streetAddress: brand.address, addressCountry: "AE" },
  },
  isPartOf: {
    "@type": "Service",
    name: "Performance Marketing",
    url: "https://enhmedia.com/services/performance-marketing",
  },
};
---

<Base
  title={c.meta.title}
  description={c.meta.description}
  canonical={HREF}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(serviceSchema)} />

  <MetaAdsPage client:load />
</Base>
