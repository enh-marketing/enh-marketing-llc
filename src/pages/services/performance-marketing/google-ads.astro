---
import Base from "@/layouts/Base.astro";
import * as c from "@/content/services/google-ads";
import { brand } from "@/lib/content";
import { GoogleAdsPage } from "@/page-bodies/services-performance-marketing-google-ads";

/* Head tags are handed to the layout as props; the structured data is emitted
   below as static HTML rather than through the island. serviceType is built
   from the document rather than written: it joins the campaign types the
   client's own opening paragraph lists, so no wording here is ours. */

const HREF = "/services/performance-marketing/google-ads";

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Google Ads",
  serviceType: `Google Ads management: ${c.opening.managesMark.join(", ")}`,
  areaServed: { "@type": "Country", name: "United Arab Emirates" },
  provider: {
    "@type": "Organization",
    name: brand.legal,
    url: "https://enhmedia.com",
    telephone: brand.phone,
    address: { "@type": "PostalAddress", streetAddress: brand.address, addressCountry: "AE" },
  },
  isPartOf: {
    "@type": "Service",
    name: "Performance Marketing",
    url: "https://enhmedia.com/services/performance-marketing",
  },
};
---

<Base
  title={c.meta.title}
  description={c.meta.description}
  canonical={HREF}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(serviceSchema)} />

  <GoogleAdsPage client:load />
</Base>
