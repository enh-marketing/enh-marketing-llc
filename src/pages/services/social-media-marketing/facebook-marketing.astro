---
import Base from "@/layouts/Base.astro";
import * as c from "@/content/services/facebook-marketing";
import { brand } from "@/lib/content";
import { FacebookMarketingPage } from "@/page-bodies/services-social-media-marketing-facebook-marketing";

const HREF = "/services/social-media-marketing/facebook-marketing";

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Facebook Marketing",
  serviceType:
    "Facebook marketing: Page setup and upkeep, monthly content planning, copy and creative coordination, scheduling, community management, reporting and paid campaign coordination",
  areaServed: { "@type": "Country", name: "United Arab Emirates" },
  provider: {
    "@type": "Organization",
    name: brand.legal,
    url: "https://enhmedia.com",
    telephone: brand.phone,
    address: { "@type": "PostalAddress", streetAddress: brand.address, addressCountry: "AE" },
  },
  isPartOf: {
    "@type": "Service",
    name: "Social Media Marketing",
    url: "https://enhmedia.com/services/social-media-marketing",
  },
};
---

<Base title={c.meta.title} description={c.meta.description} canonical={HREF}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(serviceSchema)} />
  <FacebookMarketingPage client:load />
</Base>
