---
import Base from "@/layouts/Base.astro";
import * as c from "@/content/testimonials";
import { voices } from "@/content/testimonials";
import { brand } from "@/lib/content";
import { TestimonialsPage } from "@/page-bodies/testimonials";

/* Same shape as the service pages: head tags handed to the layout as props,
   structured data emitted here as static HTML rather than through the island.

   THE SLUG IS PLURAL, THOUGH THE LIVE PAGE IS SINGULAR. src/lib/sitemap.ts has
   named this page /testimonials since the IA was resolved, and the navbar and
   footer of every page on the site already point there, so that is the
   canonical URL. /testimonial is where the page lives today, so it is carried
   as a 301 in astro.config.mjs: the old address keeps working and passes its
   equity on rather than competing with the new one. Flip both if the singular
   should stay canonical instead. */

const HREF = "/testimonials";

/* Review JSON-LD, and it is deliberately conservative.
 *
 * ONE Review PER TESTIMONIAL, WITH NO reviewRating, AND THAT IS ON PURPOSE
 * EVEN THOUGH THE PAGE SHOWS FIVE STARS. The source page draws five stars on
 * every testimonial and this page shows them, but it publishes no scale, no
 * review count and no average anywhere, and every one of those is required
 * before a bestRating/ratingValue pair means anything. Declaring 5 out of 5
 * eighteen times, with no scale behind it, is exactly the self-issued rating
 * the guideline exists to stop, so the field is absent and so is any
 * AggregateRating.
 *
 * NO itemReviewed ON THE ORGANIZATION EITHER, which is the other thing that
 * would have earned a snippet: Google does not support self-serving reviews of
 * the marked-up organisation, and stacking seven of them on our own page is the
 * pattern the guideline exists to stop. What is left is honest and useful — the
 * seven reviews, their authors and their text, attached to the page itself.
 */
const reviewSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: c.meta.title,
  url: `https://enhmedia.com${HREF}`,
  description: c.meta.description,
  // Stated as a plain count, which is checkable, rather than as a rating.
  numberOfItems: voices.length,
  publisher: {
    "@type": "Organization",
    name: brand.legal,
    url: "https://enhmedia.com",
    telephone: brand.phone,
    address: {
      "@type": "PostalAddress",
      streetAddress: brand.address,
      addressCountry: "AE",
    },
  },
  hasPart: voices.map((v) => ({
    "@type": "Review",
    reviewBody: v.quote,
    // The source gives a name and a company and no job title, so the company
    // is carried as the author's affiliation rather than dressed up as a role.
    author: {
      "@type": "Person",
      name: v.name,
      worksFor: { "@type": "Organization", name: v.org },
    },
  })),
};
---

<Base
  title={c.meta.title}
  description={c.meta.description}
  canonical={HREF}
  ogTitle="Client Testimonials — ENH Marketing"
  ogDescription="Seven ENH clients on the record, in their own words, paired with the case studies that back them."
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(reviewSchema)} />

  <TestimonialsPage client:load />
</Base>
