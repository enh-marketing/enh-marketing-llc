---
import Base from "@/layouts/Base.astro";
import * as c from "@/content/services/website-maintenance-support";
import { brand } from "@/lib/content";
import { WebsiteMaintenancePage } from "@/page-bodies/services-web-design-development-website-maintenance-support";

/* Same shape as the sibling ecommerce page: head tags handed to the layout as
   props, structured data emitted here as static HTML rather than through the
   island.

   THE SLUG. src/lib/sitemap.ts has named this page
   /services/web-design-development/website-maintenance-support since the IA was
   resolved, and both the pillar page and the ecommerce page already link to
   that address, so it is the canonical one. The "and" variant is carried as a
   redirect in astro.config.mjs so a hand-typed link still lands. */

const HREF = "/web-support-services-dubai";

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Website Maintenance & Support",
  serviceType: "Website maintenance, technical support and ongoing website improvements",
  areaServed: { "@type": "Country", name: "United Arab Emirates" },
  provider: {
    "@type": "Organization",
    name: brand.legal,
    url: "https://enhmedia.com",
    telephone: brand.phone,
    address: { "@type": "PostalAddress", streetAddress: brand.address, addressCountry: "AE" },
  },
  isPartOf: {
    "@type": "Service",
    name: "Web Design & Development",
    url: "https://enhmedia.com/services/web-design-development",
  },
};
---

<Base
  title={c.meta.title}
  description={c.meta.description}
  canonical={HREF}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(serviceSchema)} />

  <WebsiteMaintenancePage client:load />
</Base>
