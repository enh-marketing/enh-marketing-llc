---
import { Font } from "astro:assets";
/* Lenis's own stylesheet, which has never been imported on this site and
   needs to be. Its first rule is `html.lenis, html.lenis body { height: auto }`
   and the layout sets `class="h-full"` on <html>, so without it the root
   element was pinned to 100% of the viewport (812px on a phone) while the body
   ran to 21994px. Desktop tolerates that; mobile Safari does not, and it is
   the classic cause of a page that will not scroll or that fights the address
   bar. It also carries the [data-lenis-prevent] overscroll rules and the
   iframe pointer-events guard, none of which were in effect either. */
import "lenis/dist/lenis.css";
import "@/styles/globals.css";
import { SmoothScroll } from "@/components/fx/SmoothScroll";
import { Navbar } from "@/components/sections/Navbar";
import { Footer } from "@/components/sections/Footer";
import { FloatingContact } from "@/components/sections/FloatingContact";

/** The site shell, replacing app/layout.tsx.
 *
 *  WHAT MOVED, AND WHY IT LOOKS LIKE THIS. Next's Metadata API produced the
 *  head tags from an exported object; Astro has no such API, so the tags are
 *  written out here and driven by props. The set below is not invented: it is
 *  the exact set Next was emitting, read back off the built HTML of all
 *  eighteen pages before the migration. That includes the three twitter:* tags,
 *  which Next synthesised from `openGraph` without anyone asking for them, so
 *  dropping them would have been a silent SEO regression.
 *
 *  Two Next-isms are deliberately not reproduced. `<meta name="next-size-adjust">`
 *  belongs to next/font's fallback metric adjustment and means nothing outside
 *  Next. And the hashed favicon query string (`?favicon.2vob68tjqpejf.ico`) was
 *  Next's cache-busting; the icon is a plain /favicon.ico here.
 *
 *  `metadataBase` becomes `site` in astro.config.mjs, which is what resolves
 *  the canonical path to an absolute URL below. */

interface Props {
  title: string;
  description: string;
  /** Path, not URL. Resolved against `site`, the way metadataBase did. */
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  /** Path or absolute URL of the share image. Resolved against `site`, the
   *  same way `canonical` is, because og:image is one of the few tags that a
   *  relative value is simply dropped for rather than resolved by the crawler.
   *
   *  Added for /insights/[slug]: an article is the one page type on this site
   *  whose links are shared by people rather than crawled, and a link with no
   *  image is a grey rectangle in every feed it lands in. Every existing page
   *  passes nothing and its head output is unchanged to the byte. */
  ogImage?: string;
  /** "article" for a post, so the tag describes what was shared. Defaults to
   *  the "website" every other page on the site emits. */
  ogType?: string;
  /** The site shell: navbar and footer. Defaults on, which is every page but
      one. Off for a page that owns the whole viewport and draws its own way in
      and out. Everything else in this layout stays: the head tags, the fonts,
      the theme script, Lenis, the grain, and the floating contact, none of
      which are chrome in that sense. */
  chrome?: boolean;
  /** Overrides the robots tag. Default is index, follow, which is what every
   *  real page wants; an experiment kept off the search engines passes
   *  "noindex, nofollow". */
  robots?: string;
  /** Pins the page to the dark theme and takes the theme control away with it.
   *
   *  FOR A PAGE THAT PAINTS ITS OWN SURFACES rather than using the theme
   *  tokens. The AI Hub is a night mountain that becomes deep space: every
   *  colour in it is written black in the markup, because `snow` and `void` are
   *  near-black in dark and near-white in light and a story cannot follow them.
   *  The shell can, and did, so in light mode the navbar and footer came up
   *  pale at the top and bottom of a black page.
   *
   *  The class is written onto <html> here rather than added by a script, so it
   *  is in the first byte of the document and there is nothing to flash. The
   *  reader's stored preference is untouched: this is what one page looks like,
   *  not a change to what they chose for the site. The toggle goes with it,
   *  because a control that cannot change anything is worse than no control. */
  forceDark?: boolean;
}

const {
  title,
  description,
  canonical,
  ogTitle,
  ogDescription,
  ogImage,
  ogType,
  chrome = true,
  robots = "index, follow",
  forceDark = false,
} = Astro.props;

const og = ogTitle ?? title;
const ogDesc = ogDescription ?? description;
/** NO TRAILING SLASH, INCLUDING ON THE HOMEPAGE.
 *
 *  `new URL("/", site).href` returns "https://enhmedia.com/" -- the URL spec
 *  requires that slash, so the homepage was the one page whose canonical ended
 *  in one while every other page's did not. Team direction on 2026-09-11 is to
 *  publish the bare origin, so the slash is stripped and the whole site now
 *  states its canonical the same way.
 *
 *  The strip is written for every path rather than special-cased to the root,
 *  so the rule stays one rule. No other page is affected today: every `canonical`
 *  prop on the site is a slashless path such as "/seo-company-in-dubai", and
 *  `new URL` only appends a slash when the path is empty. */
const canonicalUrl = canonical
  ? new URL(canonical, Astro.site).href.replace(/\/$/, "")
  : undefined;
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site).href : undefined;
---

{/* DARK IS THE DEFAULT, so `dark` is on the server-rendered <html> and the
    script below takes it off for a reader who has chosen light. It is this way
    round rather than the reverse because the class has to be right in the very
    first byte: a page that renders light and is corrected by script flashes,
    and the flash is the thing the script exists to prevent.

    `data-force-dark` marks the pages that are pinned to dark and have no
    toggle. The script reads it and leaves those alone, so a reader whose stored
    preference is light still gets the AI Hub as it was designed rather than a
    page whose own colours are written black against a pale shell. */}
<html
  lang="en"
  class="h-full dark"
  data-force-dark={forceDark ? "" : undefined}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    <meta property="og:title" content={og} />
    <meta property="og:description" content={ogDesc} />
    <meta property="og:locale" content="en_AE" />
    <meta property="og:type" content={ogType ?? "website"} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}

    {/* summary_large_image only where there is an image to fill it. Declaring
        the large card with no og:image gets the card dropped altogether, which
        is worse than the small one every other page correctly asks for. */}
    <meta name="twitter:card" content={ogImageUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={og} />
    <meta name="twitter:description" content={ogDesc} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    <link rel="icon" href="/favicon.ico" sizes="256x256" type="image/x-icon" />

    {/* Two families, declared in astro.config.mjs and exposed as
        --font-inter and --font-cabinet, which is what the stylesheet's @theme
        block reads.

        Inter sets the body copy, so it is preloaded whole.

        Cabinet Grotesk preloads ONE weight, not four. It is declared at 500,
        700, 800 and 900, and preloading all of them put ~86KB of font files at
        high priority during load, competing with the very resources this
        change was meant to unblock. 800 is the weight every hero headline uses
        and accounts for 208 of the 332 font-display usages on the site; the
        other three arrive normally and swap in against Astro's generated
        fallback metrics, so they cost no layout shift.
 */}
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-cabinet" preload={[{ weight: 800 }]} />

    {/* ON-DEVICE PERFORMANCE READOUT, off unless the URL carries ?perf=1.
        Nothing below runs, and no listener is registered, on a normal visit.

        WHY IT EXISTS. The iPhone stall could not be reproduced here: there is
        no full Xcode on the build machine, so no iOS Simulator, and the
        headless-Chromium harness in scripts/check-mainthread.mjs leans on the
        longtask PerformanceObserver, which SAFARI DOES NOT IMPLEMENT. It was
        therefore never measuring the browser being complained about. Four
        rounds of fixes went out on inference.

        So this measures the one thing every browser can report: the gap
        between animation frames. A frozen main thread cannot paint, so a
        freeze IS a long gap, whatever caused it -- script, layout, GPU or
        WebKit's own compositor. It needs no cable, no Mac and no Web
        Inspector; load the page with ?perf=1 and screenshot the panel. */}
    <script is:inline>
      if (location.search.indexOf("perf") !== -1) {
        (function () {
          /* ?perf=1&noblur=1 -- AN A/B FOR THE ONE REMAINING STALL.
             The surviving gap starts while the opaque curtain is sliding off
             the hero, after the page has finished loading and after the
             headline has finished animating. That points at paint rather than
             script: the blurred auroras and the navbar's backdrop-blur are
             being rasterised for the first time as they are uncovered, and a
             blur is the most expensive thing on that screen.
             This switch turns those filters off and changes nothing else, so
             running the page with and without it isolates paint cost from
             everything else. It only exists alongside ?perf. */
          if (location.search.indexOf("noblur") !== -1) {
            const off = document.createElement("style");
            off.textContent =
              ".aurora-a,.aurora-b{filter:none!important}" +
              "*{backdrop-filter:none!important;-webkit-backdrop-filter:none!important}";
            document.head.appendChild(off);
          }
          const gaps = [], marks = [], seen = {};
          let last = performance.now(), veil = null;
          function frame(now) {
            const d = now - last;
            if (d > 100) gaps.push({ at: Math.round(last), ms: Math.round(d) });
            last = now;
            const c = document.querySelector('div[class*="z-[100]"]');
            if (c && veil === null) {
              const t = getComputedStyle(c).transform;
              const y = t && t.indexOf("matrix") === 0 ? parseFloat(t.split(",")[5]) : 0;
              if (y < -2) { veil = Math.round(now); marks.push("veil lifts " + veil + "ms"); }
            }
            /* NAME WHAT IS RUNNING, not just when the page stalls. One 1648ms
               gap survived at 5525ms and the candidates all fire within a few
               hundred ms of each other -- the hero's per-character reveal, the
               curtain unmounting, and the below-fold island hydrating. These
               marks put a timestamp on each so the gap can be attributed to one
               of them instead of argued about. */
            /* The animated glyph is the innermost span, and it carries a
               rotation as well as the rise, so read ty out of the matrix
               rather than matching on a string. */
            const ch = document.querySelector('h2 span[aria-hidden="true"]');
            if (ch) {
              const t2 = getComputedStyle(ch).transform;
              const y2 = t2 && t2.indexOf("matrix") === 0 ? parseFloat(t2.split(",")[5]) : 0;
              if (!seen.charsMove && Math.abs(y2) > 0.5) {
                seen.charsMove = 1; marks.push("hero chars masked at " + Math.round(now) + "ms");
              }
              if (!seen.charsDone && Math.abs(y2) <= 0.5) {
                seen.charsDone = 1; marks.push("hero chars revealed " + Math.round(now) + "ms");
              }
            }
            if (!seen.curtainGone && veil !== null && !c) {
              seen.curtainGone = 1; marks.push("curtain unmounted " + Math.round(now) + "ms");
            }
            const pend = document.querySelectorAll("astro-island[ssr]").length;
            if (seen.pend === undefined) seen.pend = pend;
            if (pend < seen.pend) {
              seen.pend = pend;
              marks.push("an island hydrated " + Math.round(now) + "ms (" + pend + " left)");
            }
            requestAnimationFrame(frame);
          }
          requestAnimationFrame(frame);

          addEventListener("load", function () {
            setTimeout(function () {
              const n = performance.getEntriesByType("navigation")[0] || {};
              const after = gaps.filter(function (g) { return veil !== null && g.at >= veil; });
              const worst = gaps.slice().sort(function (a, b) { return b.ms - a.ms; })[0];
              const box = document.createElement("div");
              box.setAttribute("style",
                "position:fixed;inset:auto 8px 8px 8px;z-index:2147483647;background:#000;color:#0f0;" +
                "font:12px/1.45 ui-monospace,Menlo,monospace;padding:10px 12px;border:1px solid #0f0;" +
                "border-radius:6px;max-height:62vh;overflow:auto;white-space:pre-wrap;word-break:break-word");
              box.textContent =
                (location.search.indexOf("noblur") !== -1 ? "*** BLURS OFF ***\n" : "*** blurs on ***\n") +
                "UA " + navigator.userAgent +
                "\nviewport " + innerWidth + "x" + innerHeight + " dpr" + devicePixelRatio +
                "\nrequestIdleCallback " + (typeof requestIdleCallback === "function") +
                "\nlongtask API " + (typeof PerformanceObserver === "function" &&
                  (PerformanceObserver.supportedEntryTypes || []).indexOf("longtask") !== -1) +
                "\ndomInteractive " + Math.round(n.domInteractive || 0) + "ms" +
                "\ndomComplete " + Math.round(n.domComplete || 0) + "ms" +
                "\n" + marks.join("\n") +
                "\n\nFRAME GAPS >100ms  (a freeze is a gap)" +
                "\ntotal " + gaps.length + "   worst " + (worst ? worst.ms + "ms at " + worst.at + "ms" : "none") +
                "\nAFTER THE VEIL: " + (veil === null ? "veil not seen" :
                  after.length + " gap(s), " + after.reduce(function (s, g) { return s + g.ms; }, 0) + "ms total") +
                "\n\n" + gaps.slice(0, 22).map(function (g) {
                  return String(g.at) + "ms  " + g.ms + "ms" + (veil !== null && g.at >= veil ? "  <-- after veil" : "");
                }).join("\n");
              document.body.appendChild(box);
            }, 6000);
          });
        })();
      }
    </script>

    {/* Was <Script strategy="beforeInteractive">. An inline is:raw script in
        the head is the Astro equivalent and runs at the same point: before
        first paint, so a reader who opted into light never sees dark first. */}
    <script is:inline>
      try {
        if (
          localStorage.getItem("enh-theme") === "light" &&
          !document.documentElement.hasAttribute("data-force-dark")
        )
          document.documentElement.classList.remove("dark");
      } catch {}
    </script>

    {/* SEARCH-ENGINE SITE VERIFICATION. One tag per property. They are inert
        HTML that each console reads once to confirm ownership of the domain,
        and they sit here rather than on one page so verification holds whichever
        URL the console is pointed at. */}
    <meta name="google-site-verification" content="j0n5ARfu9TyV1QZCd0ojc2QLJ2J4wkMqri_Krxxdsaw" />
    <meta name="msvalidate.01" content="6A89C0AE3DFA8FA72ABF2DF8D4B3E132" />
    <meta name="yandex-verification" content="a574e68bf88a76d2" />

    {/* ANALYTICS AND TAG MANAGEMENT. Every page on the site renders through
        this layout, so this is the one place they need to be.

        PRODUCTION ONLY. `import.meta.env.PROD` is false under `astro dev` and
        true under `astro build`, and it is resolved at build time rather than
        in the browser -- so in dev these tags are not merely inert, they are
        not in the document at all, and in the built HTML there is no trace of
        the condition. Without the gate, every local page view from
        localhost:4321 was a real hit against the GA4 property and a real
        recorded session in Clarity, mixed in with live traffic and impossible
        to filter out afterwards.

        ALL THREE ARE `is:inline`, AND HAVE TO BE. Astro bundles, hashes and
        hoists <script> tags by default. These are vendor snippets that must
        reach the browser byte for byte and execute where they are written --
        gtag() in particular is a function the GA4 loader looks for by name on
        `window`, which does not survive being scoped into a module. `is:inline`
        is what turns that processing off.

        THEY SIT BELOW THE <Font> PRELOADS ON PURPOSE. Google's snippet
        documentation says "as high in the head as possible", but each of these
        does its real work by injecting its own async <script>, so none of them
        blocks parsing or first paint from here. Moving them above the preloads
        would only hand a third-party request the head's first fetch slots and
        push the preloaded Inter and Cabinet 800 faces down the priority list,
        which is the one thing the preload note above exists to protect. */}
    {import.meta.env.PROD && (
      <Fragment>
        <!-- Google Tag Manager -->
        <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','GTM-TFZ3XNX');</script>
        <!-- End Google Tag Manager -->

        <!-- Google tag (gtag.js) -->
        <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-E5RDWP3M8Q"></script>
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());

          gtag('config', 'G-E5RDWP3M8Q');
        </script>

        <!-- Microsoft Clarity -->
        <script is:inline type="text/javascript">
            (function(c,l,a,r,i,t,y){
                c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
                t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
                y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
            })(window, document, "clarity", "script", "ezrckj0h7d");
        </script>
      </Fragment>
    )}

    <slot name="head" />
  </head>

  <body class="min-h-full bg-void text-snow antialiased">
    {/* GTM's no-JavaScript fallback, first thing in the body because that is
        where the tag fires a pageview from when the head snippet above never
        ran. It is a 0x0 hidden iframe and paints nothing.

        Gated with the head snippet it belongs to: it is a pageview beacon like
        the rest, and leaving it ungated would send a hit from any dev page
        view with JavaScript off -- the one case the head gate cannot cover. */}
    {import.meta.env.PROD && (
      <Fragment>
        <!-- Google Tag Manager (noscript) -->
        <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TFZ3XNX"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
        <!-- End Google Tag Manager (noscript) -->
      </Fragment>
    )}

    {/* SmoothScroll rendered a bare fragment around its children and did all
        its work in an effect, so in Astro it needs no children at all: it is a
        headless island that starts Lenis and fuses it to GSAP's ticker. The
        page content is a sibling rather than a child, which is what lets each
        page hydrate independently of it. */}
    <SmoothScroll client:load />

    <div class="grain">
      {chrome && <Navbar client:load pathname={Astro.url.pathname} showThemeToggle={!forceDark} />}
      <slot />
      {/* FOOTER HYDRATES, AND THE COMMENT HERE USED TO SAY IT DID NOT.
          "Footer carries no state or effects" was true when it was written and
          has not been since: it renders <BackToTop />, which has an onClick and
          two infinite motion animations. With no client directive Astro
          rendered it to static HTML, so the ring never turned and the button
          did nothing at all -- on every page.

          client:visible rather than client:load: it is the last thing on the
          page, so it costs nothing until someone scrolls to it, which is also
          the only moment a back-to-top button is any use. */}
      {chrome && <Footer client:visible />}
      <FloatingContact client:visible />
    </div>
  </body>
</html>
